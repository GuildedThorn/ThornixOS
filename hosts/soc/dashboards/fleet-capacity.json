{
  "uid": "fleet-capacity",
  "title": "Fleet Capacity & Performance",
  "description": "Capacity, saturation, storage I/O, network quality, and clock health for the always-on fleet and pfSense.",
  "tags": ["fleet", "infra", "capacity", "performance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "label": "Host",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(node_uname_info, instance)", "refId": "hosts" },
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Current headroom",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 1,
      "type": "bargauge",
      "title": "Root filesystem used",
      "description": "Discord warns at 85% and pages critically at 95%.",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",instance=~\"$host\"} / node_filesystem_size_bytes{mountpoint=\"/\",instance=~\"$host\"})", "instant": true, "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "orange", "value": 85 }, { "color": "red", "value": 95 }
        ] } },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "valueMode": "color", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Root inodes used",
      "description": "A filesystem can be unable to create files even with bytes free; inode alerts begin at 90% used.",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - node_filesystem_files_free{mountpoint=\"/\",instance=~\"$host\"} / node_filesystem_files{mountpoint=\"/\",instance=~\"$host\"})", "instant": true, "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "orange", "value": 90 }, { "color": "red", "value": 97 }
        ] } },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "valueMode": "color", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Memory used",
      "description": "Uses MemAvailable on Linux and an equivalent free+inactive+cache+buffer estimate on pfSense.",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "(100 * (1 - node_memory_MemAvailable_bytes{instance=~\"$host\"} / node_memory_MemTotal_bytes{instance=~\"$host\"})) or (100 * (1 - (node_memory_free_bytes{instance=~\"$host\"} + node_memory_inactive_bytes{instance=~\"$host\"} + node_memory_cache_bytes{instance=~\"$host\"} + node_memory_buffer_bytes{instance=~\"$host\"}) / node_memory_size_bytes{instance=~\"$host\"}))", "instant": true, "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "orange", "value": 90 }, { "color": "red", "value": 97 }
        ] } },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "valueMode": "color", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Filesystem capacity",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 1 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Root filesystem usage",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",instance=~\"$host\"} / node_filesystem_size_bytes{mountpoint=\"/\",instance=~\"$host\"})", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 12, "showPoints": "never", "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 85 }, { "color": "red", "value": 95 }
        ] } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Root space remaining",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "node_filesystem_avail_bytes{mountpoint=\"/\",instance=~\"$host\"}", "legendFormat": "{{instance}} now" },
        { "refId": "B", "expr": "predict_linear(node_filesystem_avail_bytes{mountpoint=\"/\",instance=~\"$host\"}[6h], 24 * 3600)", "legendFormat": "{{instance}} projected +24h" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [6, 6], "fill": "dash" } }, { "id": "custom.fillOpacity", "value": 0 }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "min"] }, "tooltip": { "mode": "multi", "sort": "asc" } }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "All persistent filesystems used",
      "description": "Excludes pseudo and container filesystems; catches a full /boot or data mount that a root-only panel misses.",
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{instance=~\"$host\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|ramfs|nsfs|fusectl\"} / node_filesystem_size_bytes{instance=~\"$host\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|ramfs|nsfs|fusectl\"})", "instant": true, "legendFormat": "{{instance}} {{mountpoint}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "orange", "value": 85 }, { "color": "red", "value": 95 }
        ] } },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "valueMode": "color", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 102,
      "type": "row",
      "title": "CPU and memory pressure",
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 1 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU busy",
      "gridPos": { "x": 0, "y": 26, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$host\"}[5m])))", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Load per CPU core",
      "description": "1.0 means the 15-minute load equals the number of logical CPU cores.",
      "gridPos": { "x": 8, "y": 26, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "node_load15{instance=~\"$host\"} / on(instance) count by (instance) (node_cpu_seconds_total{mode=\"idle\",instance=~\"$host\"})", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory used",
      "gridPos": { "x": 16, "y": 26, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "(100 * (1 - node_memory_MemAvailable_bytes{instance=~\"$host\"} / node_memory_MemTotal_bytes{instance=~\"$host\"})) or (100 * (1 - (node_memory_free_bytes{instance=~\"$host\"} + node_memory_inactive_bytes{instance=~\"$host\"} + node_memory_cache_bytes{instance=~\"$host\"} + node_memory_buffer_bytes{instance=~\"$host\"}) / node_memory_size_bytes{instance=~\"$host\"}))", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Linux pressure stalls",
      "description": "Percentage of wall time in which some or all work was delayed by CPU, memory, or I/O pressure.",
      "gridPos": { "x": 0, "y": 34, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "100 * rate(node_pressure_cpu_waiting_seconds_total{instance=~\"$host\"}[5m])", "legendFormat": "{{instance}} CPU waiting" },
        { "refId": "B", "expr": "100 * rate(node_pressure_memory_stalled_seconds_total{instance=~\"$host\"}[5m])", "legendFormat": "{{instance}} memory stalled" },
        { "refId": "C", "expr": "100 * rate(node_pressure_io_stalled_seconds_total{instance=~\"$host\"}[5m])", "legendFormat": "{{instance}} I/O stalled" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Swap use and churn",
      "gridPos": { "x": 12, "y": 34, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - node_memory_SwapFree_bytes{instance=~\"$host\"} / node_memory_SwapTotal_bytes{instance=~\"$host\"}) and on(instance) node_memory_SwapTotal_bytes{instance=~\"$host\"} > 0", "legendFormat": "{{instance}} used %" },
        { "refId": "B", "expr": "rate(node_vmstat_pswpin{instance=~\"$host\"}[5m]) + rate(node_vmstat_pswpout{instance=~\"$host\"}[5m])", "legendFormat": "{{instance}} pages/s" }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [
        { "matcher": { "id": "byFrameRefID", "options": "A" }, "properties": [{ "id": "unit", "value": "percent" }, { "id": "min", "value": 0 }, { "id": "max", "value": 100 }] },
        { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [{ "id": "unit", "value": "pps" }, { "id": "custom.axisPlacement", "value": "right" }] }
      ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Storage I/O",
      "gridPos": { "x": 0, "y": 42, "w": 24, "h": 1 }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Disk throughput",
      "gridPos": { "x": 0, "y": 43, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(node_disk_read_bytes_total{instance=~\"$host\",device!~\"loop.*|ram.*|dm-.*\"}[5m])", "legendFormat": "{{instance}} {{device}} read" },
        { "refId": "B", "expr": "-rate(node_disk_written_bytes_total{instance=~\"$host\",device!~\"loop.*|ram.*|dm-.*\"}[5m])", "legendFormat": "{{instance}} {{device}} write" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "axisCenteredZero": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Disk busy",
      "gridPos": { "x": 8, "y": 43, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "100 * rate(node_disk_io_time_seconds_total{instance=~\"$host\",device!~\"loop.*|ram.*|dm-.*\"}[5m])", "legendFormat": "{{instance}} {{device}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Average I/O latency",
      "gridPos": { "x": 16, "y": 43, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "(rate(node_disk_read_time_seconds_total{instance=~\"$host\",device!~\"loop.*|ram.*|dm-.*\"}[5m]) + rate(node_disk_write_time_seconds_total{instance=~\"$host\",device!~\"loop.*|ram.*|dm-.*\"}[5m])) / (rate(node_disk_reads_completed_total{instance=~\"$host\",device!~\"loop.*|ram.*|dm-.*\"}[5m]) + rate(node_disk_writes_completed_total{instance=~\"$host\",device!~\"loop.*|ram.*|dm-.*\"}[5m]))", "legendFormat": "{{instance}} {{device}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 104,
      "type": "row",
      "title": "Network and system integrity",
      "gridPos": { "x": 0, "y": 51, "w": 24, "h": 1 }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Network throughput",
      "gridPos": { "x": 0, "y": 52, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(node_network_receive_bytes_total{instance=~\"$host\",device!~\"lo|veth.*|docker.*|br-.*|tailscale.*|wg.*|tun.*|tap.*\"}[5m])", "legendFormat": "{{instance}} {{device}} rx" },
        { "refId": "B", "expr": "-rate(node_network_transmit_bytes_total{instance=~\"$host\",device!~\"lo|veth.*|docker.*|br-.*|tailscale.*|wg.*|tun.*|tap.*\"}[5m])", "legendFormat": "{{instance}} {{device}} tx" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "axisCenteredZero": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Network errors and drops",
      "gridPos": { "x": 8, "y": 52, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(node_network_receive_errs_total{instance=~\"$host\",device!=\"lo\"}[5m]) + rate(node_network_transmit_errs_total{instance=~\"$host\",device!=\"lo\"}[5m])", "legendFormat": "{{instance}} {{device}} errors" },
        { "refId": "B", "expr": "rate(node_network_receive_drop_total{instance=~\"$host\",device!=\"lo\"}[5m]) + rate(node_network_transmit_drop_total{instance=~\"$host\",device!=\"lo\"}[5m])", "legendFormat": "{{instance}} {{device}} drops" }
      ],
      "fieldConfig": { "defaults": { "unit": "pps", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Clock offset",
      "description": "Large offsets break cross-host log correlation and can invalidate TLS or signed requests.",
      "gridPos": { "x": 16, "y": 52, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "node_timex_offset_seconds{instance=~\"$host\"}", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "axisCenteredZero": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 18,
      "type": "bargauge",
      "title": "Uptime",
      "gridPos": { "x": 0, "y": 60, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "time() - node_boot_time_seconds{instance=~\"$host\"}", "instant": true, "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "options": { "displayMode": "basic", "orientation": "horizontal", "showUnfilled": true, "valueMode": "text", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "CPU temperature",
      "description": "Shown only on exporters that expose a temperature sensor.",
      "gridPos": { "x": 8, "y": 60, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "node_cpu_temperature_celsius{instance=~\"$host\"}", "legendFormat": "{{instance}} {{cpu}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "celsius", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "OOM kills",
      "description": "Any non-zero value is a real incident; a critical Discord alert fires immediately.",
      "gridPos": { "x": 16, "y": 60, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "increase(node_vmstat_oom_kill{instance=~\"$host\"}[$__rate_interval])", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 20, "showPoints": "auto", "drawStyle": "bars" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 105,
      "type": "row",
      "title": "Proxmox memory deduplication",
      "gridPos": { "x": 0, "y": 66, "w": 24, "h": 1 }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "KSM RAM saved now",
      "description": "Host RAM reclaimed by merging identical anonymous pages across trusted QEMU guests on mac. This cannot deduplicate across physical hosts.",
      "gridPos": { "x": 0, "y": 67, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "node_ksmd_pages_sharing{instance=\"proxmox.guildedthorn.arpa:9100\"} * 4096", "instant": true, "legendFormat": "saved" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "KSM saved and backing memory",
      "description": "Saved is the extra mappings eliminated (pages_sharing); backing is the retained shared-page set (pages_shared).",
      "gridPos": { "x": 8, "y": 67, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "node_ksmd_pages_sharing{instance=\"proxmox.guildedthorn.arpa:9100\"} * 4096", "legendFormat": "saved" },
        { "refId": "B", "expr": "node_ksmd_pages_shared{instance=\"proxmox.guildedthorn.arpa:9100\"} * 4096", "legendFormat": "shared backing" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "KSM scan rate and yield",
      "description": "Scans/hour shows advisor activity. Saved/unshared above 1 means KSM currently eliminates more pages than it repeatedly finds unique.",
      "gridPos": { "x": 16, "y": 67, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(node_ksmd_full_scans_total{instance=\"proxmox.guildedthorn.arpa:9100\"}[30m]) * 3600", "legendFormat": "full scans/hour" },
        { "refId": "B", "expr": "node_ksmd_pages_sharing{instance=\"proxmox.guildedthorn.arpa:9100\"} / clamp_min(node_ksmd_pages_unshared{instance=\"proxmox.guildedthorn.arpa:9100\"}, 1)", "legendFormat": "saved/unshared yield" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [
        { "matcher": { "id": "byFrameRefID", "options": "A" }, "properties": [{ "id": "unit", "value": "short" }] },
        { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [{ "id": "unit", "value": "none" }, { "id": "custom.axisPlacement", "value": "right" }] }
      ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
